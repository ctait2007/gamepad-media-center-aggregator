<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="spaceBetween"
    alignItems="center">

    <!-- NuvioTV's PlayerClockOverlay: the wall clock and when this will
         finish, top-right, over a shallow scrim. There is no top BAR in the
         reference — close, seek, cast and settings live on buttons (O, the
         d-pad, and X) rather than as chrome. -->
    <brls:Box
        id="video/osd/top/box"
        width="100%"
        height="300"
        axis="column"
        alignItems="flexEnd"
        paddingTop="48"
        paddingRight="64"
        backgroundStartColor="#000000B3"
        backgroundEndColor="#00000000"
        background="vertical_linear">

        <brls:Label
            id="video/osd/clock"
            fontSize="28"
            fontWeight="semibold"
            textColor="#FFFFFFF5"
            horizontalAlign="right" />
        <brls:Label
            id="video/osd/ends"
            fontSize="20"
            textColor="#FFFFFFC7"
            horizontalAlign="right" />

        <brls:Box
            id="video/speed/hint/box"
            width="100%"
            positionBottom="-10"
            visibility="gone"
            positionType="absolute"
            justifyContent="center"
            alignItems="center">
            <brls:Box
                backgroundColor="#00000080"
                cornerRadius="4"
                justifyContent="center"
                alignItems="center">
                <brls:Label
                    marginLeft="64"
                    marginRight="8"
                    marginTop="6"
                    marginBottom="6"
                    textColor="@theme/color/white"
                    id="video/speed/hint/label" />
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center"
        justifyContent="center"
        visibility="gone"
        cornerRadius="4"
        width="100"
        height="100"
        backgroundColor="#303030A0"
        id="video/osd/info/box">
        <SVGImage
            id="video/osd/info/icon"
            height="30"
            width="30"
            marginBottom="20" />
        <brls:Label
            id="video/osd/info/label"
            textColor="@theme/color/white"
            fontSize="24"
            height="16"
            horizontalAlign="center"
            verticalAlign="center" />
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center"
        id="video/osd/center/box">
        <brls:ProgressSpinner
            id="video/osd/loading"
            width="100"
            height="100" />
        <brls:Label
            id="video/osd/center/label"
            visibility="invisible"
            cornerRadius="4"
            backgroundColor="#303030A0"
            textColor="@theme/color/white"
            fontSize="28"
            height="36"
            horizontalAlign="center"
            verticalAlign="center" />
    </brls:Box>

    <!-- NuvioTV's PlayerControlsOverlay. A bottom-anchored column inside a
         200dp scrim: the identity block, the progress bar, then the control row
         with the elapsed/total on its right. Every measurement is the
         reference's own, doubled (its density is 2.0): 32dp of side padding and
         24dp below, md between the text and the bar, lg between the bar and the
         buttons, 48dp circular buttons 4dp apart. -->
    <brls:Box
        id="video/osd/bottom/box"
        width="100%"
        height="400"
        axis="column"
        justifyContent="flexEnd"
        paddingLeft="64"
        paddingRight="64"
        paddingBottom="48"
        backgroundStartColor="#00000000"
        backgroundEndColor="#000000CC"
        background="vertical_linear">

        <!-- headlineMedium SemiBold, then titleMedium at 0.9, then bodyMedium
             at 0.68. The last names the stream and appears only while PAUSED,
             which is when the reference shows it. Each carries its style's own
             tracking: headlineMedium has none, titleMedium 0.15sp and
             bodyMedium 0.25sp. -->
        <brls:Label
            id="video/osd/title"
            fontSize="48"
            fontWeight="semibold"
            singleLine="true"
            textColor="@theme/color/white" />
        <brls:Label
            id="video/osd/episode"
            fontSize="32"
            letterSpacing="0.3"
            textColor="#FFFFFFE6"
            singleLine="true"
            visibility="gone" />
        <brls:Label
            id="video/osd/source"
            fontSize="28"
            letterSpacing="0.5"
            textColor="#FFFFFFAD"
            singleLine="true"
            visibility="gone" />

        <!-- The reference's bar is an 8dp rounded track with NO knob: the
             played part is the accent, the rest white at 0.3, and focusing it
             is what thickens it rather than revealing a handle. -->
        <VideoProgressSlider
            focusable="false"
            id="video/osd/bottom/progress"
            width="100%"
            height="32"
            line="16"
            pointer="16"
            knob="false"
            marginTop="24" />

        <brls:Box
            width="100%"
            axis="row"
            alignItems="center"
            marginTop="16">
            <brls:Box
                axis="row"
                alignItems="center"
                grow="1"
                marginLeft="-4">
                <PlayerButton id="video/osd/toggle" />
                <PlayerButton id="video/osd/next" visibility="gone" />
                <PlayerButton id="video/subtitle/box" visibility="gone" />
                <PlayerButton id="video/audio/box" visibility="gone" />
                <!-- the source re-selector: the reference's fifth control, and
                     the one the row had no button for at all -->
                <PlayerButton id="video/osd/sources" visibility="gone" />
                <PlayerButton id="video/quality/box" visibility="gone" />
                <PlayerButton id="show/episode/box" visibility="gone" />
                <PlayerButton id="video/osd/cast" />
            </brls:Box>
            <brls:Label
                id="video/osd/time"
                fontSize="28"
                textColor="#FFFFFFE6"
                horizontalAlign="right" />
        </brls:Box>

        <brls:Box
            cornerRadius="4"
            backgroundColor="@theme/brls/backdrop"
            detachedX="30"
            detachedY="-20"
            visibility="gone"
            height="32"
            id="video/osd/hint/box">
            <brls:Label
                id="video/osd/hint/label"
                marginLeft="10"
                marginRight="10"
                marginTop="4"
                marginBottom="4"
                maxWidth="600"
                textColor="@theme/color/white" />
        </brls:Box>
    </brls:Box>

</brls:Box>
