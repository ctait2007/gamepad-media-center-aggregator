<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="spaceBetween"
    alignItems="center">

    <brls:Box
        width="50"
        height="50"
        alignItems="center"
        hideHighlightBorder="true"
        highlightBackgroundColor="@theme/color/focus/bg"
        highlightPadding="2"
        highlightCornerRadius="10"
        backgroundColor="#303030A0"
        focusable="true"
        focusUp="video/osd/setting/icon"
        focusDown="video/audio/box"
        focusRight="video/osd/lock/box"
        focusLeft="video/osd/lock/box"
        cornerRadius="8"
        positionTop="45%"
        positionRight="20"
        positionType="absolute"
        id="video/osd/lock/box">
        <SVGImage
            id="video/osd/lock/icon"
            detachedX="13"
            detachedY="13"
            height="24"
            width="24"
            svg="@res/icon/player-unlock.svg" />
    </brls:Box>

    <!-- NuvioTV's PlayerClockOverlay: the wall clock and when this will
         finish, top-right, over a shallow scrim. There is no top BAR in the
         reference — close, seek, cast and settings live on buttons (O, the
         d-pad, and X) rather than as chrome. -->
    <brls:Box
        id="video/osd/top/box"
        width="100%"
        height="300"
        axis="column"
        alignItems="flexEnd"
        paddingTop="48"
        paddingRight="64"
        backgroundStartColor="#000000B3"
        backgroundEndColor="#00000000"
        background="vertical_linear">

        <brls:Label
            id="video/osd/clock"
            fontSize="26"
            fontWeight="semibold"
            textColor="#FFFFFFF5"
            horizontalAlign="right" />
        <brls:Label
            id="video/osd/ends"
            fontSize="20"
            textColor="#FFFFFFC7"
            horizontalAlign="right" />

        <brls:Box
            id="video/speed/hint/box"
            width="100%"
            positionBottom="-10"
            visibility="gone"
            positionType="absolute"
            justifyContent="center"
            alignItems="center">
            <brls:Box
                backgroundColor="#00000080"
                cornerRadius="4"
                justifyContent="center"
                alignItems="center">
                <brls:Label
                    marginLeft="64"
                    marginRight="8"
                    marginTop="6"
                    marginBottom="6"
                    textColor="@theme/color/white"
                    id="video/speed/hint/label" />
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center"
        justifyContent="center"
        visibility="gone"
        cornerRadius="4"
        width="100"
        height="100"
        backgroundColor="#303030A0"
        id="video/osd/info/box">
        <SVGImage
            id="video/osd/info/icon"
            height="30"
            width="30"
            marginBottom="20" />
        <brls:Label
            id="video/osd/info/label"
            textColor="@theme/color/white"
            fontSize="24"
            height="16"
            horizontalAlign="center"
            verticalAlign="center" />
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center"
        id="video/osd/center/box">
        <brls:ProgressSpinner
            id="video/osd/loading"
            width="100"
            height="100" />
        <brls:Label
            id="video/osd/center/label"
            visibility="invisible"
            cornerRadius="4"
            backgroundColor="#303030A0"
            textColor="@theme/color/white"
            fontSize="16"
            height="16"
            horizontalAlign="center"
            verticalAlign="center" />
    </brls:Box>

    <!-- NuvioTV's PlayerControlsOverlay. A bottom-anchored column inside a
         200dp scrim: the identity block, the progress bar, then the control row
         with the elapsed/total on its right. Every measurement is the
         reference's own, doubled (its density is 2.0): 32dp of side padding and
         24dp below, md between the text and the bar, lg between the bar and the
         buttons, 48dp circular buttons 4dp apart. -->
    <brls:Box
        id="video/osd/bottom/box"
        width="100%"
        height="400"
        axis="column"
        justifyContent="flexEnd"
        paddingLeft="64"
        paddingRight="64"
        paddingBottom="48"
        backgroundStartColor="#00000000"
        backgroundEndColor="#000000CC"
        background="vertical_linear">

        <!-- headlineMedium, then titleMedium at 0.9, then bodyMedium at 0.68.
             The last names the stream and appears only while PAUSED, which is
             when the reference shows it. -->
        <brls:Label
            id="video/osd/title"
            fontSize="48"
            fontWeight="medium"
            singleLine="true"
            textColor="@theme/color/white" />
        <brls:Label
            id="video/osd/episode"
            fontSize="32"
            textColor="#FFFFFFE6"
            singleLine="true"
            visibility="gone" />
        <brls:Label
            id="video/osd/source"
            fontSize="28"
            textColor="#FFFFFFAD"
            singleLine="true"
            visibility="gone" />

        <!-- The reference's bar is an 8dp rounded track with NO knob: the
             played part is the accent, the rest white at 0.3, and focusing it
             is what thickens it rather than revealing a handle. -->
        <VideoProgressSlider
            focusable="false"
            id="video/osd/bottom/progress"
            width="100%"
            height="32"
            line="16"
            pointer="16"
            knob="false"
            marginTop="24" />

        <brls:Box
            width="100%"
            axis="row"
            alignItems="center"
            marginTop="16">
            <brls:Box
                axis="row"
                alignItems="center"
                grow="1"
                marginLeft="-4">
                <PlayerButton id="video/osd/toggle" />
                <PlayerButton id="video/osd/next" visibility="gone" />
                <PlayerButton id="video/subtitle/box" visibility="gone" />
                <PlayerButton id="video/audio/box" visibility="gone" />
                <PlayerButton id="video/quality/box" visibility="gone" />
                <PlayerButton id="show/episode/box" visibility="gone" />
                <PlayerButton id="video/osd/cast" />
            </brls:Box>
            <brls:Label
                id="video/osd/time"
                fontSize="28"
                textColor="#FFFFFFE6"
                horizontalAlign="right" />
        </brls:Box>

        <brls:Box
            cornerRadius="4"
            backgroundColor="@theme/brls/backdrop"
            detachedX="30"
            detachedY="-20"
            visibility="gone"
            height="32"
            id="video/osd/hint/box">
            <brls:Label
                id="video/osd/hint/label"
                marginLeft="10"
                marginRight="10"
                marginTop="4"
                marginBottom="4"
                maxWidth="600"
                textColor="@theme/color/white" />
        </brls:Box>
    </brls:Box>

</brls:Box>
