<brls:Box
    highlightCornerRadius="@style/brls/highlight/corner_radius"
    axis="column"
    width="auto"
    height="auto">
    <!-- same skeleton as video_card.xml (2:3 poster area + the label block,
         both off the same metrics) so it aligns pixel by pixel with the row's
         covers -->
    <brls:Box
        id="more/card/box"
        axis="column"
        focusable="true"
        highlightCornerRadius="@style/brls/highlight/corner_radius"
        cornerRadius="@style/app/card/corner_radius"
        backgroundColor="@theme/color/grey_1"
        alignItems="center"
        justifyContent="center"
        grow="1">

        <SVGImage
            width="36"
            height="36"
            svg="@res/icon/ico-plus.svg" />

    </brls:Box>

    <brls:Box
        axis="column"
        height="@style/app/card/labels"
        paddingTop="@style/app/card/label/top"
        paddingLeft="8"
        paddingRight="8"
        alignItems="flexStart">
        <brls:Label
            singleLine="true"
            id="more/card/label"
            height="@style/app/card/label/title_height"
            fontSize="@style/app/card/label/title_size"
            text="@i18n/main/media/see_all" />
        <brls:Label
            singleLine="true"
            fontSize="@style/app/card/label/sub_size"
            height="@style/app/card/label/sub_height" />
    </brls:Box>

</brls:Box>
