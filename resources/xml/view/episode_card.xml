<brls:Box
    highlightCornerRadius="20"
    padding="5">

    <!-- NuvioTV's episode tile: one 16:9 backdrop with everything printed over
         its lower half, instead of a thumbnail with a column of text beside it.
         The cell fills its grid slot (the grid sizes it 16:9 via
         itemImageRatio), so no fixed pixel size here — the old 300x180 could
         not follow the span count.
         pic_box stays the focusable node: BaseCardCell::getDefaultFocus()
         returns it, which is what keeps the focus halo on the artwork. -->
    <brls:Box
        id="video/card/pic_box"
        focusable="true"
        width="100%"
        height="100%"
        highlightCornerRadius="20"
        cornerRadius="16"
        backgroundColor="@theme/color/grey_1">

        <!-- placeholder behind the image: an episode with no still keeps the
             box, the icon and the focus halo rather than collapsing -->
        <brls:Box
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="100%"
            height="100%"
            alignItems="center"
            justifyContent="center">
            <SVGImage
                width="36"
                height="36"
                svg="@res/icon/ico-media.svg" />
        </brls:Box>

        <brls:Image
            id="video/card/picture"
            scalingType="fill"
            width="100%"
            height="100%"
            cornerRadius="16" />

        <!-- the text sits on this, not bare artwork: a still with a bright
             lower half would otherwise swallow the title -->
        <brls:Image
            positionType="absolute"
            positionBottom="0"
            positionLeft="0"
            width="100%"
            height="78%"
            scalingType="stretch"
            cornerRadius="16"
            image="@res/img/fade-bottom-dark.png" />

        <!-- EPISODE N -->
        <brls:Box
            id="episode/card/number_box"
            positionType="absolute"
            positionTop="10"
            positionLeft="10"
            cornerRadius="4"
            paddingTop="3"
            paddingBottom="3"
            paddingLeft="8"
            paddingRight="8"
            backgroundColor="@theme/color/scrim">
            <brls:Label
                id="episode/card/number"
                fontSize="20"
                fontWeight="medium" />
        </brls:Box>

        <SVGImage
            id="video/card/badge/top"
            positionType="absolute"
            positionTop="10"
            positionRight="10"
            height="24" />

        <!-- "downloaded" badge, below the watched checkmark so they never
             collide on an episode that is both -->
        <brls:Box
            id="video/card/badge/download"
            positionType="absolute"
            positionTop="42"
            positionRight="10"
            visibility="gone"
            cornerRadius="4"
            paddingTop="4"
            paddingBottom="4"
            paddingLeft="4"
            paddingRight="4"
            backgroundColor="@theme/color/app">
            <SVGImage
                width="16"
                height="16"
                svg="@res/icon/ico-download-light.svg" />
        </brls:Box>

        <brls:Box
            positionType="absolute"
            positionBottom="18"
            positionLeft="0"
            width="100%"
            axis="column"
            paddingLeft="18"
            paddingRight="18">
            <brls:Label
                id="episode/card/name"
                singleLine="true"
                fontSize="32"
                fontWeight="medium"
                marginBottom="4" />
            <TextBox
                id="episode/card/overview"
                fontSize="24"
                lineHeight="1.33"
                letterSpacing="0.8"
                maxRows="3"
                marginBottom="10" />
            <!-- runtime/rating at the left, air date at the right, as the
                 reference splits them -->
            <brls:Box
                axis="row"
                alignItems="center"
                width="100%">
                <brls:Label
                    id="episode/card/meta"
                    singleLine="true"
                    grow="1.0"
                    fontSize="20" />
                <!-- shrink 0: the runtime label beside it grows to fill the
                     row, and without this the date is the one that gets
                     squeezed down to "January 1, ..." -->
                <brls:Label
                    id="episode/card/date"
                    singleLine="true"
                    shrink="0.0"
                    horizontalAlign="right"
                    fontSize="20" />
            </brls:Box>
        </brls:Box>

        <brls:Box
            wireframe="false"
            positionType="absolute"
            positionBottom="0"
            visibility="gone"
            width="100%"
            height="3"
            backgroundColor="#353535">
            <brls:Rectangle
                id="video/card/progress"
                height="3"
                width="50%"
                color="@theme/color/app" />
        </brls:Box>
    </brls:Box>

</brls:Box>
