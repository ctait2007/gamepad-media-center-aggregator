<!-- Download card: rounded 2:3 poster, title + subtitle, progress block
     (gold) for the in-progress item, state badge + size on the right.
     Variants driven by DownloadCard::setItem (download_tab.cpp). -->
<brls:Box
    highlightCornerRadius="@style/brls/highlight/corner_radius"
    cornerRadius="@style/app/card/corner_radius"
    backgroundColor="@theme/color/surface"
    paddingTop="20"
    paddingBottom="20"
    paddingLeft="24"
    paddingRight="28"
    alignItems="center">

    <!-- cornerRadius mandatory: it is what clips the scalingType="fill" -->
    <brls:Image
        id="download/thumb"
        width="112"
        height="168"
        marginRight="28"
        scalingType="fill"
        cornerRadius="12"
        backgroundColor="@theme/color/grey_1"
        image="@res/img/video-card-bg.png" />

    <brls:Box
        axis="column"
        justifyContent="center"
        grow="1.0"
        shrink="1.0">

        <brls:Label
            id="download/name"
            fontSize="32"
            singleLine="true" />

        <brls:Label
            id="download/detail"
            fontSize="24"
            marginTop="8"
            singleLine="true"
            textColor="@theme/font/grey" />

        <brls:Box
            id="download/progress/row"
            axis="column"
            marginTop="24"
            visibility="gone">
            <!-- 8px track filled by the SegmentedBar (C++): gold progress -->
            <brls:Box
                id="download/progress/track"
                height="8" />
            <brls:Label
                id="download/progress/info"
                fontSize="24"
                marginTop="12"
                textColor="@theme/font/grey" />
        </brls:Box>
    </brls:Box>

    <!-- borealis only accepts camelCase (flexEnd): "flex-end" is a
         FATAL at inflate — and this XML only inflates at the FIRST cell,
         so only when the download list is not empty -->
    <brls:Box
        axis="column"
        alignItems="flexEnd"
        justifyContent="center"
        marginLeft="28">

        <brls:Box
            id="download/badge"
            cornerRadius="20"
            height="40"
            alignItems="center"
            paddingLeft="16"
            paddingRight="16"
            backgroundColor="@theme/color/pill">
            <brls:Label
                id="download/status"
                fontSize="24" />
        </brls:Box>

        <brls:Label
            id="download/percent"
            fontSize="32"
            visibility="gone"
            textColor="@theme/color/app" />

        <brls:Label
            id="download/size"
            fontSize="24"
            marginTop="10"
            textColor="@theme/font/grey" />
    </brls:Box>
</brls:Box>
