<!-- "Storage" card, row 0 of the downloads list (StorageCard cell) so it
     scrolls WITH the list. NOT a RecyclingGrid scrolled header: that crashes
     when the Downloads pill is the RemoteTab's default tab (see download_tab). -->
<brls:Box
    axis="column"
    cornerRadius="@style/app/card/corner_radius"
    backgroundColor="@theme/color/surface"
    paddingTop="28"
    paddingBottom="28"
    paddingLeft="28"
    paddingRight="28">

    <brls:Label
        text="@i18n/main/download/storage"
        fontSize="32"
        marginBottom="24" />

    <!-- 16px track filled by the SegmentedBar (C++):
         [rest of disk | pleNx (gold) | free (dark gray)] -->
    <brls:Box
        id="downloads/storage/bar"
        height="16"
        marginBottom="20" />

    <brls:Box alignItems="center">
        <brls:Rectangle
            width="16"
            height="16"
            cornerRadius="8"
            color="@theme/color/app"
            marginRight="12" />
        <brls:Label
            id="downloads/storage/app"
            fontSize="24" />

        <brls:Box grow="1.0" />

        <brls:Rectangle
            width="16"
            height="16"
            cornerRadius="8"
            color="@theme/color/pill"
            marginRight="12" />
        <brls:Label
            id="downloads/storage/free"
            fontSize="24"
            textColor="@theme/font/grey" />
    </brls:Box>
</brls:Box>
