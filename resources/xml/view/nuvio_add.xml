<!-- Nuvio sign-in: full-screen centered page, same visual language as the
     Jellyfin/Stremio sign-in pages. Icon + grey title, then a full-width form
     (backend URL / email / password), centered Connect button and a status
     label. B (Back) is owned by the ServerList AppletFrame. -->
<brls:Box
    width="auto"
    height="auto"
    alignItems="center"
    justifyContent="center">

    <brls:Box
        width="640"
        axis="column"
        alignItems="stretch">

        <brls:Box
            width="100%"
            height="auto"
            axis="column"
            alignItems="center"
            marginBottom="30">

            <brls:Image
                width="120"
                height="120"
                cornerRadius="28"
                marginBottom="16"
                scalingType="fit"
                image="@res/icon/icon.png" />

            <brls:Label
                id="nuvio/add/header"
                fontSize="16"
                textColor="@theme/font/grey"
                text="" />
        </brls:Box>

        <brls:InputCell
            id="nuvio/add/url" />

        <brls:InputCell
            id="nuvio/add/email" />

        <brls:InputCell
            id="nuvio/add/passwd"
            type="password" />

        <brls:Box
            width="100%"
            height="auto"
            axis="column"
            alignItems="center"
            marginTop="28">

            <brls:Button
                id="nuvio/add/connect"
                style="primary"
                paddingLeft="40"
                paddingRight="40"
                text="@i18n/main/server/nuvio/connect" />

            <brls:ProgressSpinner
                id="nuvio/add/spinner"
                width="44"
                height="44"
                visibility="gone" />

            <brls:Label
                id="nuvio/add/status"
                width="100%"
                height="auto"
                marginTop="16"
                fontSize="15"
                horizontalAlign="center"
                textColor="@theme/font/grey"
                text="" />
        </brls:Box>

    </brls:Box>
</brls:Box>
