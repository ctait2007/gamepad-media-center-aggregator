<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- NuvioTV's home screen, from the reference recording:
         the FOCUSED item's backdrop fills the whole screen behind everything,
         heavily dimmed; a fixed text block sits over its upper-left; and the
         rows scroll independently below, over the art. The hero never scrolls
         and is never focusable — focus lives entirely in the rows. -->
    <brls:Image
        id="home/hero/backdrop"
        positionType="absolute"
        positionTop="0"
        positionLeft="0"
        width="100%"
        height="100%"
        scalingType="fill" />
    <brls:Rectangle
        positionType="absolute"
        positionTop="0"
        positionLeft="0"
        width="100%"
        height="100%"
        color="@theme/color/hero_scrim" />

    <!-- Bottom-anchored (justifyContent=flexEnd): in the reference the synopsis
         always ends at the same height whatever the logo's size, so the block
         grows UPWARD from its baseline rather than down from the top. -->
    <brls:Box
        id="home/hero"
        width="46%"
        height="46%"
        axis="column"
        justifyContent="flexEnd"
        paddingBottom="26"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="20">

        <!-- The item's cut-out logo, as in the reference. Hidden until its
             pixels actually arrive: an advertised logo url is not proof the
             artwork exists (Cinemeta templates one per IMDb id and metahub
             404s the misses), so home_tab only reveals it on a confirmed
             load and shows the label below instead when it fails. -->
        <brls:Image
            id="home/hero/logo"
            width="330"
            height="96"
            visibility="gone"
            marginBottom="12"
            scalingType="fit" />

        <!-- last resort: shown only when the item has no logo anywhere, not
             even in its full metadata -->
        <brls:Label
            id="home/hero/title"
            fontSize="38"
            singleLine="true"
            visibility="gone"
            marginBottom="12" />

        <brls:Label
            id="home/hero/meta"
            fontSize="17"
            singleLine="true"
            marginBottom="10" />

        <!-- 3 rows, not 4: the band has to hold title + meta + synopsis with
             clearance above the first row title in the worst case. -->
        <TextBox
            id="home/hero/overview"
            fontSize="17"
            maxRows="3" />
    </brls:Box>

    <brls:ScrollingFrame
        id="home/scroll"
        width="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <!-- no side padding here: each row carries its own (sidePadding)
             so the cards scroll up to the edges -->
        <brls:Box
            axis="column"
            id="home/box"
            paddingBottom="@style/main/content_padding_top_bottom" />

    </brls:ScrollingFrame>

</brls:Box>
