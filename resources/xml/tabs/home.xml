<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- NuvioTV's home screen, from the reference screenshots: the FOCUSED
         item's backdrop occupies the TOP-RIGHT of the screen — it is not a
         full-screen wash — and dissolves into the page background along its
         left and bottom edges, with the text block on plain background beside
         it. The hero never scrolls and is never focusable: focus lives
         entirely in the rows below. -->
    <brls:Box
        id="home/hero/art"
        positionType="absolute"
        positionTop="0"
        positionRight="0"
        width="64%"
        height="54%">

        <!-- cornerRadius is not decoration here: on brls:Image with
             scalingType="fill" it is what enables the render clip, without
             which the image spills outside this box (cf. movie.xml). -->
        <brls:Image
            id="home/hero/backdrop"
            width="100%"
            height="100%"
            scalingType="fill"
            cornerRadius="1" />

        <!-- left edge, so the art has no seam against the text column -->
        <brls:Image
            id="home/hero/fade/left"
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="46%"
            height="100%"
            scalingType="stretch"
            image="@res/img/fade-left-dark.png" />

        <!-- and the bottom edge, into the rows. Its own asset, not the card
             fade: that one ends on (13,14,17) and never quite reaches full
             opacity at the sampled edge, which left a line of bare artwork
             along the bottom of the hero. This one lands on the exact page
             background and holds it solid for its last fifth. -->
        <brls:Image
            positionType="absolute"
            positionBottom="0"
            positionLeft="0"
            width="100%"
            height="58%"
            scalingType="stretch"
            image="@res/img/fade-hero-bottom-dark.png" />
    </brls:Box>

    <!-- Bottom-anchored (justifyContent=flexEnd): in the reference the synopsis
         always ends at the same height whatever the logo's size, so the block
         grows UPWARD from its baseline rather than down from the top. Its width
         stops short of the backdrop's solid part. -->
    <brls:Box
        id="home/hero"
        width="44%"
        height="45%"
        axis="column"
        justifyContent="flexEnd"
        paddingBottom="18"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="20">

        <!-- The item's cut-out logo, as in the reference. Hidden until its
             pixels actually arrive: an advertised logo url is not proof the
             artwork exists (Cinemeta templates one per IMDb id and metahub
             404s the misses), so home_tab only reveals it on a confirmed
             load and shows the label below instead when it fails. -->
        <brls:Image
            id="home/hero/logo"
            width="460"
            height="118"
            visibility="gone"
            marginBottom="14"
            scalingType="fit"
            imageAlign="left" />

        <!-- last resort: shown only when the item has no logo anywhere, not
             even in its full metadata -->
        <brls:Label
            id="home/hero/title"
            fontSize="56"
            fontWeight="semibold"
            singleLine="true"
            visibility="gone"
            marginBottom="14" />

        <!-- two meta lines like the reference: what the thing IS (episode,
             genre, year) above what it will cost you (time left, rating) -->
        <!-- One row, as the reference builds it: what this is, then a trailing
             group of runtime, year and rating. -->
        <brls:Box
            axis="row"
            alignItems="center"
            height="32"
            marginBottom="8">
            <brls:Label
                id="home/hero/meta"
                fontSize="24"
                fontWeight="medium"
                letterSpacing="1"
                singleLine="true" />
            <SVGImage
                id="home/hero/rating1/icon"
                width="36"
                height="18"
                shrink="0"
                visibility="gone"
                marginLeft="14"
                marginRight="7" />
            <brls:Label
                id="home/hero/rating1"
                fontSize="24"
                fontWeight="medium"
                letterSpacing="1"
                singleLine="true"
                shrink="0"
                visibility="gone" />
        </brls:Box>

        <brls:Box
            id="home/hero/meta2"
            axis="row"
            alignItems="center"
            height="32"
            marginBottom="12">
            <brls:Label
                id="home/hero/meta2/text"
                fontSize="24"
                fontWeight="medium"
                letterSpacing="1"
                singleLine="true" />
            <!-- the rating's own mark (IMDb / RT / TMDb), as on the detail
                 page — sized to the glyph's aspect in C++ -->
            <SVGImage
                id="home/hero/rating/icon"
                width="36"
                height="18"
                shrink="0"
                visibility="gone"
                marginRight="7" />
            <brls:Label
                id="home/hero/rating"
                fontSize="24"
                fontWeight="medium"
                letterSpacing="1"
                singleLine="true"
                shrink="0"
                visibility="gone" />
        </brls:Box>

        <!-- 3 rows, not 4: the band has to hold logo + meta + synopsis with
             clearance above the first row title in the worst case. -->
        <!-- bodyMedium, four rows (ModernHomeHero's descriptionMaxLines). The
             size is scaled to 0.90 in C++ when the posters are portrait, which
             is what its descriptionScale does and what our default is. -->
        <TextBox
            id="home/hero/overview"
            fontSize="28"
            lineHeight="1.43"
            letterSpacing="0.5"
            maxRows="4" />
    </brls:Box>

    <brls:ScrollingFrame
        id="home/scroll"
        width="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <!-- no side padding here: each row carries its own (sidePadding)
             so the cards scroll up to the edges -->
        <brls:Box
            axis="column"
            id="home/box"
            paddingBottom="@style/main/content_padding_top_bottom" />

    </brls:ScrollingFrame>

</brls:Box>
