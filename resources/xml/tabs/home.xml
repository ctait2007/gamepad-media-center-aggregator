<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- NuvioTV's home screen, from the reference screenshots: the FOCUSED
         item's backdrop occupies the TOP-RIGHT of the screen — it is not a
         full-screen wash — and dissolves into the page background along its
         left and bottom edges, with the text block on plain background beside
         it. The hero never scrolls and is never focusable: focus lives
         entirely in the rows below. -->
    <brls:Box
        id="home/hero/art"
        positionType="absolute"
        positionTop="0"
        positionRight="0"
        width="64%"
        height="54%">

        <!-- cornerRadius is not decoration here: on brls:Image with
             scalingType="fill" it is what enables the render clip, without
             which the image spills outside this box (cf. movie.xml). -->
        <brls:Image
            id="home/hero/backdrop"
            width="100%"
            height="100%"
            scalingType="fill"
            cornerRadius="1" />

        <!-- left edge, so the art has no seam against the text column -->
        <brls:Image
            id="home/hero/fade/left"
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="46%"
            height="100%"
            scalingType="stretch"
            image="@res/img/fade-left-dark.png" />

        <!-- and the bottom edge, into the rows. Its own asset, not the card
             fade: that one ends on (13,14,17) and never quite reaches full
             opacity at the sampled edge, which left a line of bare artwork
             along the bottom of the hero. This one lands on the exact page
             background and holds it solid for its last fifth. -->
        <brls:Image
            positionType="absolute"
            positionBottom="0"
            positionLeft="0"
            width="100%"
            height="58%"
            scalingType="stretch"
            image="@res/img/fade-hero-bottom-dark.png" />
    </brls:Box>

    <!-- Bottom-anchored (justifyContent=flexEnd): in the reference the synopsis
         always ends at the same height whatever the logo's size, so the block
         grows UPWARD from its baseline rather than down from the top. Its width
         stops short of the backdrop's solid part.

         The height is a percentage of the CONTENT area (1028 at 1080p -- the
         screen less the hint bar), not of the screen, so this is 501px: enough
         for the tallest the block gets (logo 200 + two meta rows + a four-line
         synopsis) and placed so the synopsis' last line and the first row's
         title land where the reference puts them. Measured against it: the
         synopsis ends at y=485 and the row title below starts at y=525. -->
    <brls:Box
        id="home/hero"
        width="44%"
        height="48.7%"
        axis="column"
        justifyContent="flexEnd"
        paddingBottom="3"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="20">

        <!-- The item's cut-out logo, as in the reference. Hidden until its
             pixels actually arrive: an advertised logo url is not proof the
             artwork exists (Cinemeta templates one per IMDb id and metahub
             404s the misses), so home_tab only reveals it on a confirmed
             load and shows the label below instead when it fails. -->
        <brls:Image
            id="home/hero/logo"
            width="440"
            height="200"
            visibility="gone"
            marginBottom="15"
            scalingType="fit"
            imageAlign="left" />

        <!-- last resort: shown only when the item has no logo anywhere, not
             even in its full metadata -->
        <brls:Label
            id="home/hero/title"
            fontSize="56"
            fontWeight="semibold"
            singleLine="true"
            visibility="gone"
            marginBottom="15" />

        <!-- Two meta rows, as ModernHomeHero's HeroTitleContent builds them.
             Both are filled from C++ (renderHero) because their contents are a
             SEQUENCE -- text, dot, text, dot, logo, text -- whose length varies
             per item, and the separator is NuvioTV's HeroMetaDivider: a round
             4dp dot in TextTertiary at 78%, not a "•" glyph.

             Row 1 is what the thing IS: "S1 E4 · The Luminous Fish Effect",
             its first genre, its runtime, its year (or year RANGE, as the
             provider wrote it), and -- for a movie with nothing to say on row
             two -- its rating.
             Row 2 is the Continue Watching highlight ("NEXT UP", "45% WATCHED",
             "27M LEFT") and the rating that goes with it. -->
        <brls:Box
            id="home/hero/meta"
            axis="row"
            alignItems="center"
            height="24"
            marginBottom="15" />

        <brls:Box
            id="home/hero/meta2"
            axis="row"
            alignItems="center"
            height="24"
            marginBottom="15" />

        <!-- bodyMedium, four rows (ModernHomeHero's descriptionMaxLines). The
             size is scaled to 0.90 in C++ when the posters are portrait, which
             is what its descriptionScale does and what our default is.

             marginTop is the half-leading Compose puts ABOVE a paragraph's
             first line and nanovg does not: measured against the reference,
             its meta row sits 4px further from the synopsis than ours did.
             Because this column is bottom-anchored the margin lifts the meta
             rows rather than dropping the synopsis, so the last line stays
             where the reference ends it. -->
        <TextBox
            id="home/hero/overview"
            marginTop="4"
            fontSize="28"
            lineHeight="1.43"
            letterSpacing="0.5"
            maxRows="4" />
    </brls:Box>

    <brls:ScrollingFrame
        id="home/scroll"
        width="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <!-- no side padding here: each row carries its own (sidePadding)
             so the cards scroll up to the edges -->
        <brls:Box
            axis="column"
            id="home/box"
            paddingBottom="@style/main/content_padding_top_bottom" />

    </brls:ScrollingFrame>

</brls:Box>
