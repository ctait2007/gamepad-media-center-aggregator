<!--
    Search, following NuvioTV's SearchScreen.kt: a field across the top (which
    is where focus lands), and under it EITHER the recent searches — one
    focusable row per query with its own remove button — or the results. There
    is no on-screen keyboard: the field opens the platform's own (the PS4
    dialog), and the search runs the moment it returns, with no separate
    submit step.
-->
<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingLeft="@style/main/content_padding_sides"
    paddingRight="@style/main/content_padding_sides"
    paddingTop="@style/main/content_padding_top_bottom">

    <brls:Box
        axis="row"
        width="100%"
        alignItems="center">

        <brls:Box
            id="search/field"
            focusable="true"
            grow="1"
            height="96"
            alignItems="center"
            paddingLeft="32"
            paddingRight="32"
            cornerRadius="24"
            highlightCornerRadius="28"
            borderThickness="3">
            <SVGImage
                id="search/icon"
                width="36"
                height="36"
                marginRight="20"
                svg="@res/icon/ico-search.svg" />
            <brls:Label
                id="search/input"
                grow="1"
                singleLine="true"
                fontSize="32" />
        </brls:Box>

        <!-- beside the field rather than inside it, so the D-pad can reach it -->
        <brls:Box
            id="search/clear"
            focusable="true"
            visibility="gone"
            width="96"
            height="96"
            marginLeft="24"
            alignItems="center"
            justifyContent="center"
            cornerRadius="24"
            highlightCornerRadius="28"
            borderThickness="3">
            <SVGImage
                width="36"
                height="36"
                svg="@res/icon/ico-close.svg" />
        </brls:Box>
    </brls:Box>

    <!-- recent searches: shown until the query is long enough to search on -->
    <brls:ScrollingFrame
        id="search/recent_scroll"
        grow="1"
        marginTop="40"
        scrollingBehavior="centered">
        <brls:Box
            axis="column"
            width="100%"
            height="auto"
            paddingLeft="8"
            paddingRight="26"
            paddingTop="8"
            paddingBottom="40">

            <brls:Box
                id="search/recent_header"
                axis="row"
                width="100%"
                alignItems="center"
                marginBottom="20">
                <brls:Label
                    grow="1"
                    singleLine="true"
                    fontSize="32"
                    fontWeight="medium"
                    text="@i18n/main/search/recent" />
                <brls:Box
                    id="search/clear_history"
                    focusable="true"
                    height="72"
                    alignItems="center"
                    justifyContent="center"
                    paddingLeft="32"
                    paddingRight="32"
                    cornerRadius="24"
                    highlightCornerRadius="28">
                    <brls:Label
                        singleLine="true"
                        fontSize="28"
                        fontWeight="medium"
                        text="@i18n/main/search/clear_history_action" />
                </brls:Box>
            </brls:Box>

            <brls:Box
                id="search/recent_list"
                axis="column"
                width="100%"
                height="auto" />

            <brls:Box
                id="search/recent_empty"
                axis="column"
                width="100%"
                alignItems="center"
                justifyContent="center"
                marginTop="120"
                visibility="gone">
                <SVGImage
                    width="72"
                    height="72"
                    marginBottom="24"
                    svg="@res/icon/ico-search.svg" />
                <brls:Label
                    horizontalAlign="center"
                    fontSize="32"
                    fontWeight="medium"
                    text="@i18n/main/search/start_title" />
                <brls:Label
                    marginTop="8"
                    horizontalAlign="center"
                    fontSize="28"
                    textColor="@theme/font/grey"
                    text="@i18n/main/search/start_sub" />
            </brls:Box>
        </brls:Box>
    </brls:ScrollingFrame>

    <!-- results, grouped the way the reference groups them: one row per
         catalog that matched. Backends with a single search endpoint have no
         grouping to show, so they get the flat grid below instead; exactly one
         of the two is ever visible. -->
    <brls:ScrollingFrame
        id="search/rows_scroll"
        grow="1"
        marginTop="40"
        visibility="gone"
        scrollingBehavior="centered">
        <brls:Box
            id="search/rows"
            axis="column"
            width="100%"
            height="auto"
            paddingBottom="@style/main/content_padding_top_bottom" />
    </brls:ScrollingFrame>

    <RecyclingGrid
        id="search/results"
        grow="1"
        marginTop="40"
        visibility="gone"
        paddingBottom="@style/main/content_padding_top_bottom"
        itemHeight="@style/app/video/height"
        itemImageRatio="1.5"
        spanCount="6" />

</brls:Box>
