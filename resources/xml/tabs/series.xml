<brls:Box
    width="auto"
    height="auto">

    <!-- centered: the scroll follows the D-pad focus (buttons -> seasons -> rows) -->
    <brls:ScrollingFrame
        id="series/scroll"
        grow="1.0"
        scrollingBehavior="centered">

        <brls:Box
            axis="column"
            paddingBottom="@style/main/content_padding_top_bottom">

            <!-- NuvioTV's detail hero: the backdrop IS the screen. Its own
                 Column is 540dp tall there — a whole 1080p screen — with
                 everything bottom-aligned over it and the rows scrolling up
                 from underneath. The height is set in C++ from the design
                 resolution so 720p/544p panels get their own screenful.
                 NB: keep a cornerRadius on brls:Image with scalingType="fill",
                 it is what enables the render clip (otherwise the image
                 overflows its box). -->
            <brls:Box
                id="series/banner"
                width="100%"
                height="1080">
                <brls:Image
                    id="series/image/backdrop"
                    width="100%"
                    height="100%"
                    scalingType="fill"
                    cornerRadius="1"
                    backgroundColor="@theme/color/grey_1" />

                <!-- left edge: the reference darkens the side the text sits on
                     so a bright still cannot swallow the synopsis -->
                <brls:Image
                    positionType="absolute"
                    positionTop="0"
                    positionLeft="0"
                    width="58%"
                    height="100%"
                    scalingType="stretch"
                    image="@res/img/fade-left-dark.png" />

                <brls:Image
                    id="series/banner/fade"
                    positionType="absolute"
                    positionBottom="0"
                    positionLeft="0"
                    width="100%"
                    height="62%"
                    scalingType="stretch"
                    image="@res/img/fade-hero-bottom-dark.png" />

                <brls:Box
                    id="series/content/row"
                    positionType="absolute"
                    positionBottom="0"
                    positionLeft="0"
                    width="100%"
                    paddingLeft="@style/main/content_padding_sides"
                    paddingRight="@style/main/content_padding_sides"
                    paddingBottom="32">

                    <!-- Nuvio's detail hero has no poster: the backdrop IS the
                         hero. Kept in the tree (the C++ still binds and loads
                         it) but collapsed. -->
                    <brls:Box
                        visibility="gone"
                        width="220"
                        axis="column">
                        <brls:Image
                            id="series/image/poster"
                            width="100%"
                            height="330"
                            scalingType="fill"
                            cornerRadius="12" />
                    </brls:Box>

                    <brls:Box
                        id="series/content/info"
                        axis="column"
                        width="100%"
                        grow="1.0">

                        <!-- 100dp tall, 0.4 of the content width, Fit and
                             left-aligned, exactly as the reference sizes it.
                             Revealed only once its pixels arrive. -->
                        <brls:Image
                            id="series/image/logo"
                            width="690"
                            height="200"
                            visibility="gone"
                            marginBottom="32"
                            scalingType="fit" />

                        <!-- the reference shows the logo OR the name, never
                             both: the text title is the fallback -->
                        <brls:Label
                            id="series/label/title"
                            fontSize="72"
                            singleLine="true"
                            visibility="gone"
                            marginBottom="16" />

                        <brls:Box
                            id="series/buttons"
                            axis="row"
                            alignItems="center"
                            marginBottom="32">

                            <IconButton
                                id="series/play"
                                icon="@res/icon/ico-play-dark.svg"
                                text="@i18n/main/media/play"
                                buttonStyle="primary"
                                height="96"
                                cornerRadius="48"
                                highlightCornerRadius="52"
                                paddingLeft="48"
                                paddingRight="48"
                                fontSize="28"
                                iconSize="36" />

                            <!-- circular icon-only actions, like the "+" and
                                 trailer buttons beside the reference's Play -->
                            <IconButton
                                id="series/watchlist"
                                icon="@res/icon/ico-bookmark-light.svg"
                                buttonStyle="icon"
                                visibility="gone"
                                width="96"
                                height="96"
                                cornerRadius="48"
                                highlightCornerRadius="52"
                                paddingLeft="0"
                                paddingRight="0"
                                iconSize="44"
                                marginLeft="24" />

                            <IconButton
                                id="series/download"
                                icon="@res/icon/ico-download-light.svg"
                                buttonStyle="icon"
                                width="96"
                                height="96"
                                cornerRadius="48"
                                highlightCornerRadius="52"
                                paddingLeft="0"
                                paddingRight="0"
                                iconSize="44"
                                marginLeft="24" />
                        </brls:Box>

                        <!-- 0.6 of the content width and bodyMedium sized, as
                             the reference sets it -->
                        <TextBox
                            id="series/label/overview"
                            width="60%"
                            fontSize="28"
                            maxRows="4"
                            marginBottom="24" />

                        <!-- primary meta: genres, year, rating -->
                        <brls:Box
                            axis="row"
                            alignItems="center"
                            marginBottom="16">
                            <brls:Label
                                id="series/label/genres"
                                fontSize="28"
                                animated="false"
                                singleLine="true" />
                            <brls:Label
                                id="series/meta/sep1"
                                fontSize="28"
                                visibility="gone"
                                text="  •  " />
                            <brls:Label
                                id="series/label/year"
                                fontSize="28"
                                singleLine="true" />
                            <brls:Label
                                id="series/meta/sep2"
                                fontSize="28"
                                visibility="gone"
                                text="  •  " />
                            <brls:Box
                                id="series/rating/box"
                                axis="row"
                                alignItems="center"
                                visibility="gone">
                                <SVGImage
                                    id="series/rating/icon"
                                    width="36"
                                    height="18"
                                    marginRight="8"
                                    svg="@res/icon/ico-star.svg" />
                                <brls:Label
                                    id="series/label/rating"
                                    singleLine="true"
                                    fontSize="28" />
                            </brls:Box>
                        </brls:Box>

                        <!-- secondary meta: age rating, runtime, country -->
                        <brls:Box
                            axis="row"
                            alignItems="center">
                            <brls:Box
                                cornerRadius="6"
                                height="38"
                                alignItems="center"
                                justifyContent="center"
                                paddingLeft="14"
                                paddingRight="14"
                                marginRight="24"
                                borderThickness="2"
                                borderColor="@theme/color/grey_3"
                                visibility="gone">
                                <brls:Label
                                    id="series/parental/rating"
                                    singleLine="true"
                                    fontSize="24" />
                            </brls:Box>
                            <brls:Label
                                id="series/label/runtime"
                                fontSize="24"
                                singleLine="true" />

                            <!-- audience rating: no addon backend supplies one,
                                 but the binding (and the Plex/Jellyfin path)
                                 still expects the views to exist -->
                            <brls:Box
                                axis="row"
                                alignItems="center"
                                marginLeft="24"
                                visibility="gone">
                                <SVGImage
                                    id="series/audience/icon"
                                    width="18"
                                    height="18"
                                    marginRight="8"
                                    svg="@res/icon/rating/rt_upright.svg" />
                                <brls:Label
                                    id="series/label/audience"
                                    singleLine="true"
                                    fontSize="24" />
                            </brls:Box>
                        </brls:Box>
                    </brls:Box>
                </brls:Box>
            </brls:Box>

            <!-- full-width rows: insets inside the scroll (full-bleed),
                 ~28 between the end of a row and the next Header.
                 The "Seasons" row replaces the tabs. -->
            <!-- NuvioTV's season picker: a row of pills over a HORIZONTAL rail
                 of episode tiles, both on the show page. The old design was a
                 row of season POSTERS that opened a separate page holding the
                 episode list; the episodes are one D-pad move away now.
                 The pills are built in C++ (one per season). -->
            <brls:Box
                id="series/season_pills"
                axis="row"
                marginTop="28"
                marginBottom="14"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides"
                alignItems="center" />

            <!-- The reference fits about three of these across a 1080p
                 screen (~640x415 each), not four and a half: the still is the
                 point of the tile, and the blurb needs the room. -->
            <HRecyclerFrame
                height="420"
                itemWidth="640"
                itemSpace="20"
                marginBottom="28"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                id="series/episodes" />

            <brls:Header
                marginBottom="6"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides"
                id="series/label/people"
                title="@i18n/main/media/people" />

            <HRecyclerFrame
                height="250"
                itemWidth="140"
                itemSpace="18"
                marginBottom="28"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                id="series/people" />

            <brls:Header
                marginBottom="6"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides"
                id="series/label/special"
                title="@i18n/main/media/special" />

            <HRecyclerFrame
                height="190"
                itemWidth="250"
                itemSpace="18"
                marginBottom="28"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                id="series/special" />

            <brls:Box
                id="series/related/box"
                axis="column" />

        </brls:Box>

    </brls:ScrollingFrame>
</brls:Box>
