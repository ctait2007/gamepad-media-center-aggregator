<!-- NuvioTV's settings screen is two panes, not one long scroll: a rail of
     category cards on the left picks what the right-hand pane shows
     (SettingsScreen.kt). The rail entries are built in C++ (SettingsNavItem);
     every category's content lives here, one collapsed page per category, and
     SettingTab reveals the selected one. -->
<brls:Box
    width="auto"
    height="auto"
    paddingLeft="@style/main/content_padding_sides"
    paddingRight="@style/main/content_padding_sides"
    paddingTop="@style/main/content_padding_top_bottom"
    paddingBottom="@style/main/content_padding_top_bottom">

    <brls:Box
        grow="1"
        axis="row"
        cornerRadius="56"
        borderThickness="2"
        borderColor="#FFFFFF14"
        backgroundColor="#FFFFFF08"
        paddingLeft="32"
        paddingRight="32"
        paddingTop="32"
        paddingBottom="32">

        <!-- left: the category rail -->
        <brls:Box
            axis="column"
            width="458">
            <brls:ScrollingFrame
                id="setting/nav_scroll"
                grow="1"
                scrollingBehavior="centered">
                <brls:Box
                    id="setting/nav"
                    axis="column"
                    width="100%"
                    height="auto"
                    paddingLeft="8"
                    paddingRight="8"
                    paddingTop="8"
                    paddingBottom="8" />
            </brls:ScrollingFrame>
        </brls:Box>

        <!-- right: the selected category -->
        <brls:Box
            axis="column"
            grow="1"
            marginLeft="24">

            <brls:Label
                id="setting/page/title"
                fontSize="48"
                fontWeight="semibold"
                singleLine="true" />
            <brls:Label
                id="setting/page/subtitle"
                fontSize="28"
                marginTop="4"
                singleLine="true"
                textColor="@theme/font/grey" />

            <brls:Box
                grow="1"
                axis="column"
                marginTop="24"
                cornerRadius="28"
                backgroundColor="#FFFFFF0A"
                paddingLeft="12"
                paddingRight="12"
                paddingTop="12"
                paddingBottom="12">
                <brls:ScrollingFrame
                    id="setting/detail_scroll"
                    grow="1"
                    scrollingBehavior="centered">
                    <brls:Box
                        axis="column"
                        width="100%"
                        height="auto"
                        paddingLeft="16"
                        paddingRight="26"
                        paddingTop="8"
                        paddingBottom="24">

                        <!-- Account -->
                        <brls:Box
                            id="setting/page/account"
                            width="100%"
                            height="auto"
                            axis="column"
                            visibility="gone">
                            <DisclosureCell
                                title="@i18n/main/server/switch_title"
                                id="setting/connections" />
                        </brls:Box>

                        <!-- Appearance -->
                        <brls:Box
                            id="setting/page/appearance"
                            width="100%"
                            height="auto"
                            axis="column"
                            visibility="gone">
                            <!-- colour theme (NuvioTV's list); takes effect
                                 immediately, no relaunch, so no quitApp -->
                            <SelectorCell
                                id="setting/ui/accent" />
                            <SelectorCell
                                id="setting/ui/theme"
                                quitApp="true" />
                            <BooleanCell
                                id="setting/ui/amoled" />
                            <BooleanCell
                                id="setting/ui/amoled_surfaces" />
                            <SelectorCell
                                id="setting/ui/scale"
                                quitApp="true" />
                            <SelectorCell
                                id="setting/ui/font"
                                quitApp="true" />
                            <SelectorCell
                                id="setting/language"
                                quitApp="true" />
                            <SelectorCell
                                id="setting/keymap"
                                quitApp="true" />
                        </brls:Box>

                        <!-- Layout -->
                        <brls:Box
                            id="setting/page/layout"
                            width="100%"
                            height="auto"
                            axis="column"
                            visibility="gone">
                            <SettingsSection
                                title="@i18n/main/setting/section/home/title"
                                subtitle="@i18n/main/setting/section/home/sub"
                                expanded="true">
                                <BooleanCell
                                    id="setting/layout/show_hero"
                                    icon="image"
                                    subtitle="@i18n/main/setting/sub/layout_show_hero" />
                                <BooleanCell
                                    id="setting/layout/fullscreen_hero"
                                    icon="aspect_ratio"
                                    subtitle="@i18n/main/setting/sub/layout_fullscreen_hero" />
                                <BooleanCell
                                    id="setting/layout/landscape_posters"
                                    icon="aspect_ratio"
                                    subtitle="@i18n/main/setting/sub/layout_landscape_posters" />
                                <SelectorCell
                                    id="setting/layout/card_width"
                                    icon="aspect_ratio"
                                    subtitle="@i18n/main/setting/sub/layout_card_width" />
                                <SelectorCell
                                    id="setting/layout/card_radius"
                                    icon="aspect_ratio"
                                    subtitle="@i18n/main/setting/sub/layout_card_radius" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/content/title"
                                subtitle="@i18n/main/setting/section/content/sub"
                                expanded="false">
                                <BooleanCell
                                    id="setting/ui/poster_labels"
                                    icon="text_fields"
                                    subtitle="@i18n/main/setting/sub/ui_poster_labels" />
                                <BooleanCell
                                    id="setting/layout/catalog_addon_name"
                                    icon="folder"
                                    subtitle="@i18n/main/setting/sub/layout_catalog_addon_name" />
                                <BooleanCell
                                    id="setting/layout/catalog_type"
                                    icon="list"
                                    subtitle="@i18n/main/setting/sub/layout_catalog_type" />
                                <BooleanCell
                                    id="setting/layout/hide_unreleased"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/layout_hide_unreleased" />
                                <DisclosureCell
                                    id="setting/hidden_rows"
                                    icon="list"
                                    subtitle="@i18n/main/setting/sub/hidden_rows" />
                                <DisclosureCell
                                    id="setting/libraries"
                                    icon="folder"
                                    subtitle="@i18n/main/setting/sub/libraries" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/detail/title"
                                subtitle="@i18n/main/setting/section/detail/sub"
                                expanded="false">
                                <BooleanCell
                                    id="setting/layout/show_ratings"
                                    icon="info"
                                    subtitle="@i18n/main/setting/sub/layout_show_ratings" />
                                <BooleanCell
                                    id="setting/layout/full_release_date"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/layout_full_release_date" />
                                <BooleanCell
                                    id="setting/layout/episode_overlay_art"
                                    icon="image"
                                    subtitle="@i18n/main/setting/sub/layout_episode_overlay_art" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/streams/title"
                                subtitle="@i18n/main/setting/section/streams/sub"
                                expanded="false">
                                <BooleanCell
                                    id="setting/layout/stream_addon_logo"
                                    icon="folder"
                                    subtitle="@i18n/main/setting/sub/layout_stream_addon_logo" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/cw/title"
                                subtitle="@i18n/main/setting/section/cw/sub"
                                expanded="false">
                                <BooleanCell
                                    id="setting/layout/show_continue"
                                    icon="history"
                                    subtitle="@i18n/main/setting/sub/layout_show_continue" />
                                <BooleanCell
                                    id="setting/layout/cw_episode_thumbs"
                                    icon="image"
                                    subtitle="@i18n/main/setting/sub/layout_cw_episode_thumbs" />
                                <BooleanCell
                                    id="setting/layout/cw_next_up_furthest"
                                    icon="skip_next"
                                    subtitle="@i18n/main/setting/sub/layout_cw_next_up_furthest" />
                                <BooleanCell
                                    id="setting/layout/cw_show_unaired"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/layout_cw_show_unaired" />
                                <SelectorCell
                                    id="setting/layout/cw_sort_mode"
                                    icon="list"
                                    subtitle="@i18n/main/setting/sub/layout_cw_sort_mode" />
                            </SettingsSection>
                        </brls:Box>

                        <!-- Playback -->
                        <brls:Box
                            id="setting/page/playback"
                            width="100%"
                            height="auto"
                            axis="column"
                            visibility="gone">
                            <SettingsSection
                                title="@i18n/main/setting/section/general/title"
                                subtitle="@i18n/main/setting/section/general/sub"
                                expanded="true">
                                <BooleanCell
                                    id="setting/player/loading_screen"
                                    icon="image"
                                    subtitle="@i18n/main/setting/sub/player_loading_screen" />
                                <BooleanCell
                                    id="setting/player/loading_stages"
                                    icon="list"
                                    subtitle="@i18n/main/setting/sub/player_loading_stages" />
                                <BooleanCell
                                    id="setting/player/pause_screen"
                                    icon="pause_circle"
                                    subtitle="@i18n/main/setting/sub/player_pause_screen" />
                                <BooleanCell
                                    id="setting/player/osd_clock"
                                    icon="timer"
                                    subtitle="@i18n/main/setting/sub/player_osd_clock" />
                                <BooleanCell
                                    id="setting/player/osd_on_toggle"
                                    icon="tune"
                                    subtitle="@i18n/main/setting/sub/player_osd_on_toggle" />
                                <BooleanCell
                                    id="setting/player/parental_guide"
                                    icon="info"
                                    subtitle="@i18n/main/setting/sub/player_parental_guide" />
                                <BooleanCell
                                    id="setting/player/clip_point"
                                    icon="history"
                                    subtitle="@i18n/main/setting/sub/player_clip_point" />
                                <BooleanCell
                                    id="setting/player/touch_gesture"
                                    icon="tune"
                                    subtitle="@i18n/main/setting/sub/player_touch_gesture" />
                                <BooleanCell
                                    id="setting/player/tv_model"
                                    icon="tv"
                                    subtitle="@i18n/main/setting/sub/player_tv_model" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/skip/title"
                                subtitle="@i18n/main/setting/section/skip/sub"
                                expanded="false">
                                <BooleanCell
                                    id="setting/player/skip_intro_enabled"
                                    icon="history"
                                    subtitle="@i18n/main/setting/sub/player_skip_intro_enabled" />
                                <BooleanCell
                                    id="setting/player/introdb"
                                    icon="search"
                                    subtitle="@i18n/main/setting/sub/player_introdb" />
                                <BooleanCell
                                    id="setting/player/auto_skip_intro"
                                    icon="skip_next"
                                    subtitle="@i18n/main/setting/sub/player_auto_skip_intro" />
                                <BooleanCell
                                    id="setting/player/auto_skip_recap"
                                    icon="skip_next"
                                    subtitle="@i18n/main/setting/sub/player_auto_skip_recap" />
                                <BooleanCell
                                    id="setting/player/auto_skip_outro"
                                    icon="skip_next"
                                    subtitle="@i18n/main/setting/sub/player_auto_skip_outro" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/stream/title"
                                subtitle="@i18n/main/setting/section/stream/sub"
                                expanded="false">
                                <SelectorCell
                                    id="setting/player/stream_autoplay_mode"
                                    icon="play_arrow"
                                    subtitle="@i18n/main/setting/sub/player_stream_autoplay_mode" />
                                <InputCell
                                    id="setting/player/stream_autoplay_regex"
                                    icon="search"
                                    subtitle="@i18n/main/setting/sub/player_stream_autoplay_regex" />
                                <BooleanCell
                                    id="setting/player/prefer_binge_group"
                                    icon="list"
                                    subtitle="@i18n/main/setting/sub/player_prefer_binge_group" />
                                <BooleanCell
                                    id="setting/player/next_episode_card"
                                    icon="skip_next"
                                    subtitle="@i18n/main/setting/sub/player_next_episode_card" />
                                <BooleanCell
                                    id="setting/player/next_episode_autoplay"
                                    icon="skip_next"
                                    subtitle="@i18n/main/setting/sub/player_next_episode_autoplay" />
                                <SelectorCell
                                    id="setting/player/next_episode_mode"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/player_next_episode_mode" />
                                <SelectorCell
                                    id="setting/player/next_episode_percent"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/player_next_episode_percent" />
                                <SelectorCell
                                    id="setting/player/next_episode_minutes"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/player_next_episode_minutes" />
                                <BooleanCell
                                    id="setting/player/still_watching"
                                    icon="visibility"
                                    subtitle="@i18n/main/setting/sub/player_still_watching" />
                                <SelectorCell
                                    id="setting/player/still_watching_threshold"
                                    icon="schedule"
                                    subtitle="@i18n/main/setting/sub/player_still_watching_threshold" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/audio/title"
                                subtitle="@i18n/main/setting/section/audio/sub"
                                expanded="false">
                                <BooleanCell
                                    id="setting/video/hwdec"
                                    icon="memory"
                                    subtitle="@i18n/main/setting/sub/video_hwdec" />
                                <SelectorCell
                                    id="setting/mpv/vo"
                                    icon="tv"
                                    subtitle="@i18n/main/setting/sub/mpv_vo" />
                                <BooleanCell
                                    id="setting/video/low_quality"
                                    icon="speed"
                                    subtitle="@i18n/main/setting/sub/video_low_quality" />
                                <SelectorCell
                                    id="setting/video/inmemory"
                                    icon="storage"
                                    subtitle="@i18n/main/setting/sub/video_inmemory" />
                                <SelectorCell
                                    id="setting/playback/audio_channels"
                                    icon="volume_up"
                                    subtitle="@i18n/main/setting/sub/playback_audio_channels" />
                                <SelectorCell
                                    id="setting/playback/audio_lang"
                                    icon="volume_up"
                                    subtitle="@i18n/main/setting/sub/playback_audio_lang" />
                                <BooleanCell
                                    id="setting/player/audio_delay_remember"
                                    icon="volume_up"
                                    subtitle="@i18n/main/setting/sub/player_audio_delay_remember" />
                                <BooleanCell
                                    id="setting/video/directplay"
                                    icon="play_arrow"
                                    subtitle="@i18n/main/setting/sub/video_directplay" />
                                <SelectorCell
                                    id="setting/transcode/codec"
                                    icon="memory"
                                    subtitle="@i18n/main/setting/sub/transcode_codec" />
                            </SettingsSection>
                            <SettingsSection
                                title="@i18n/main/setting/section/subtitles/title"
                                subtitle="@i18n/main/setting/section/subtitles/sub"
                                expanded="false">
                                <SelectorCell
                                    id="setting/playback/subtitle_lang"
                                    icon="subtitles"
                                    subtitle="@i18n/main/setting/sub/playback_subtitle_lang" />
                                <SelectorCell
                                    id="setting/playback/sub_secondary_lang"
                                    icon="subtitles"
                                    subtitle="@i18n/main/setting/sub/playback_sub_secondary_lang" />
                                <BooleanCell
                                    id="setting/player/sub_only_preferred"
                                    icon="list"
                                    subtitle="@i18n/main/setting/sub/player_sub_only_preferred" />
                                <BooleanCell
                                    id="setting/player/sub_use_forced"
                                    icon="subtitles"
                                    subtitle="@i18n/main/setting/sub/player_sub_use_forced" />
                                <BooleanCell
                                    id="setting/video/subs_fallback"
                                    icon="subtitles"
                                    subtitle="@i18n/main/setting/sub/video_subs_fallback" />
                                <BooleanCell
                                    id="setting/player/sub_strip_sdh"
                                    icon="text_fields"
                                    subtitle="@i18n/main/setting/sub/player_sub_strip_sdh" />
                                <SelectorCell
                                    id="setting/player/sub_size"
                                    icon="format_size"
                                    subtitle="@i18n/main/setting/sub/player_sub_size" />
                                <SelectorCell
                                    id="setting/player/sub_offset"
                                    icon="format_size"
                                    subtitle="@i18n/main/setting/sub/player_sub_offset" />
                                <BooleanCell
                                    id="setting/player/sub_bold"
                                    icon="text_fields"
                                    subtitle="@i18n/main/setting/sub/player_sub_bold" />
                                <BooleanCell
                                    id="setting/player/sub_outline"
                                    icon="text_fields"
                                    subtitle="@i18n/main/setting/sub/player_sub_outline" />
                                <SelectorCell
                                    id="setting/player/sub_outline_width"
                                    icon="text_fields"
                                    subtitle="@i18n/main/setting/sub/player_sub_outline_width" />
                                <SelectorCell
                                    id="setting/player/sub_text_color"
                                    icon="palette"
                                    subtitle="@i18n/main/setting/sub/player_sub_text_color" />
                                <SelectorCell
                                    id="setting/player/sub_bg_color"
                                    icon="palette"
                                    subtitle="@i18n/main/setting/sub/player_sub_bg_color" />
                                <SelectorCell
                                    id="setting/player/sub_outline_color"
                                    icon="palette"
                                    subtitle="@i18n/main/setting/sub/player_sub_outline_color" />
                            </SettingsSection>
                        </brls:Box>

                        <!-- Advanced -->
                        <brls:Box
                            id="setting/page/advanced"
                            width="100%"
                            height="auto"
                            axis="column"
                            visibility="gone">
                            <SelectorCell
                                id="setting/network/threads" />
                            <SelectorCell
                                id="setting/network/timeout" />
                            <BooleanCell
                                id="setting/network/proxy_status" />
                            <InputCell
                                id="setting/network/proxy"
                                visibility="gone" />
                            <InputCell
                                id="setting/network/proxy_user"
                                visibility="gone" />
                            <InputCell
                                id="setting/network/proxy_passwd"
                                type="password"
                                visibility="gone" />

                            <brls:Header
                                width="auto"
                                height="auto"
                                marginTop="20"
                                title="@i18n/main/setting/advanced/performance"
                                marginBottom="0px" />
                            <BooleanCell
                                id="setting/advanced/fast_horizontal_nav" />
                            <BooleanCell
                                id="setting/advanced/startup_splash" />

                            <brls:Header
                                width="auto"
                                height="auto"
                                marginTop="20"
                                title="@i18n/main/setting/advanced/diagnostics"
                                marginBottom="0px" />
                            <BooleanCell
                                id="setting/advanced/player_stats_hud" />

                            <brls:Header
                                width="auto"
                                height="auto"
                                marginTop="20"
                                title="@i18n/main/setting/ui/header"
                                marginBottom="0px" />
                            <SelectorCell
                                id="setting/ui/vsync" />
                            <BooleanCell
                                id="setting/ui/show_fps" />
                            <BooleanCell
                                id="setting/fullscreen" />
                            <BooleanCell
                                id="setting/always_on_top" />
                            <BooleanCell
                                id="setting/single" />
                            <BooleanCell
                                id="setting/overclock" />
                            <BooleanCell
                                id="setting/sync" />
                            <BooleanCell
                                id="setting/debug" />

                            <brls:Header
                                width="auto"
                                height="auto"
                                marginTop="20"
                                title="@i18n/main/setting/tutorial/header"
                                marginBottom="0px" />
                            <ActionCell
                                id="tools/tutorial_open"
                                title="@i18n/main/setting/tutorial/open" />
                            <ActionCell
                                id="tools/tutorial_error"
                                title="@i18n/main/setting/tutorial/error" />
                            <ActionCell
                                id="tools/tutorial_font"
                                title="@i18n/main/setting/tutorial/font" />
                            <ActionCell
                                id="tools/config_dir"
                                title="@i18n/main/setting/others/config_dir" />
                        </brls:Box>

                        <!-- About -->
                        <brls:Box
                            id="setting/page/about"
                            width="100%"
                            height="auto"
                            axis="column"
                            visibility="gone">
                            <DisclosureCell
                                title="@i18n/main/about/header"
                                id="setting/about" />
                            <ActionCell
                                id="setting/changelog"
                                title="@i18n/main/setting/others/changelog" />
                            <ActionCell
                                id="setting/release_checker" />
                        </brls:Box>

                    </brls:Box>
                </brls:ScrollingFrame>
            </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:Box>
