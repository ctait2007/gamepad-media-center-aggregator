<brls:Box
    width="auto"
    height="auto">

    <!-- centered: the scroll follows the D-pad focus (sources -> cast -> rows).
         The first source row is set as the scroll's "top anchor" in C++
         (media_movie.cpp) so focusing it scrolls to the top (poster/title stay
         visible) instead of centering it. -->
    <brls:ScrollingFrame
        id="movie/scroll"
        grow="1.0"
        scrollingBehavior="centered">

        <brls:Box
            axis="column"
            paddingBottom="@style/main/content_padding_top_bottom">

            <!-- NuvioTV's detail hero: the backdrop IS the screen, with
                 everything bottom-aligned over it and the rest scrolling up
                 from underneath. Height set in C++ from the design resolution.
                 NB: keep a cornerRadius on brls:Image with scalingType="fill",
                 it is what enables the render clip. -->
            <brls:Box
                id="movie/banner"
                width="100%"
                height="1080">
                <brls:Image
                    id="movie/image/backdrop"
                    width="100%"
                    height="100%"
                    scalingType="fill"
                    cornerRadius="1"
                    backgroundColor="@theme/color/grey_1" />

                <brls:Image
                    positionType="absolute"
                    positionTop="0"
                    positionLeft="0"
                    width="58%"
                    height="100%"
                    scalingType="stretch"
                    image="@res/img/fade-left-dark.png" />

                <brls:Image
                    id="movie/banner/fade"
                    positionType="absolute"
                    positionBottom="0"
                    positionLeft="0"
                    width="100%"
                    height="62%"
                    scalingType="stretch"
                    image="@res/img/fade-hero-bottom-dark.png" />

                <brls:Box
                    id="movie/content/row"
                    positionType="absolute"
                    positionBottom="0"
                    positionLeft="0"
                    width="100%"
                    paddingLeft="@style/main/content_padding_sides"
                    paddingRight="@style/main/content_padding_sides"
                    paddingBottom="32">

                    <brls:Box
                        visibility="gone"
                        width="220"
                        axis="column">
                        <brls:Image
                            id="movie/image/poster"
                            width="100%"
                            height="330"
                            scalingType="fill"
                            cornerRadius="12" />
                        <brls:SelectorCell
                            id="movie/source"
                            visibility="gone"
                            height="40"
                            marginTop="20px" />
                    </brls:Box>

                    <brls:Box
                        id="movie/content/info"
                        axis="column"
                        width="100%"
                        grow="1.0">

                        <brls:Image
                            id="movie/image/logo"
                            width="690"
                            height="200"
                            visibility="gone"
                            marginBottom="32"
                            scalingType="fit"
                            imageAlign="left" />

                        <brls:Label
                            id="movie/label/title"
                            fontSize="72"
                            fontWeight="bold"
                            singleLine="true"
                            visibility="gone"
                            marginBottom="16" />

                        <brls:Box
                            id="movie/buttons"
                            axis="row"
                            alignItems="center"
                            marginBottom="32">

                            <IconButton
                                id="movie/play"
                                icon="@res/icon/ico-play.svg"
                                text="@i18n/main/media/play"
                                buttonStyle="outline"
                                height="96"
                                cornerRadius="48"
                                highlightCornerRadius="52"
                                paddingLeft="48"
                                paddingRight="48"
                                fontSize="28"
                                iconSize="36" />

                            <IconButton
                                id="movie/watchlist"
                                icon="@res/icon/ico-bookmark-light.svg"
                                buttonStyle="icon"
                                iconOnly="true"
                                visibility="gone"
                                width="96"
                                height="96"
                                cornerRadius="48"
                                highlightCornerRadius="52"
                                paddingLeft="0"
                                paddingRight="0"
                                iconSize="44"
                                marginLeft="24" />

                            <IconButton
                                id="movie/download"
                                icon="@res/icon/ico-download-light.svg"
                                buttonStyle="icon"
                                iconOnly="true"
                                width="96"
                                height="96"
                                cornerRadius="48"
                                highlightCornerRadius="52"
                                paddingLeft="0"
                                paddingRight="0"
                                iconSize="44"
                                marginLeft="24" />
                        </brls:Box>

                        <!-- "no playable source" notice, built in C++ -->
                        <brls:Box
                            id="movie/notice"
                            axis="column"
                            visibility="gone"
                            marginBottom="16" />

                        <!-- "Director: ..." / "Creator: ...", the line the
                             reference prints between the buttons and the
                             synopsis -->
                        <brls:Label
                            id="movie/label/credit"
                            fontSize="28"
                            fontWeight="medium"
                            singleLine="true"
                            visibility="gone"
                            marginBottom="16" />

                        <TextBox
                            id="movie/label/overview"
                            width="60%"
                            fontSize="28"
                            maxRows="4"
                            marginBottom="24" />

                        <brls:Box
                            axis="row"
                            alignItems="center"
                            marginBottom="16">
                            <brls:Label
                                id="movie/label/genres"
                                fontSize="28"
                                fontWeight="medium"
                                animated="false"
                                singleLine="true" />
                            <brls:Label
                                id="movie/meta/sep1"
                                fontSize="28"
                                visibility="gone"
                                text="  •  " />
                            <brls:Label
                                id="movie/label/year"
                                fontSize="28"
                                fontWeight="medium"
                                singleLine="true" />
                            <brls:Label
                                id="movie/meta/sep2"
                                fontSize="28"
                                visibility="gone"
                                text="  •  " />
                            <brls:Box
                                id="movie/rating/box"
                                axis="row"
                                alignItems="center"
                                visibility="gone">
                                <SVGImage
                                    id="movie/rating/icon"
                                    width="36"
                                    height="18"
                                    marginRight="8"
                                    svg="@res/icon/ico-star.svg" />
                                <brls:Label
                                    id="movie/label/rating"
                                    singleLine="true"
                                    fontSize="28"
                                    fontWeight="medium" />
                            </brls:Box>
                        </brls:Box>

                        <brls:Box
                            axis="row"
                            alignItems="center">
                            <brls:Box
                                cornerRadius="6"
                                height="38"
                                alignItems="center"
                                justifyContent="center"
                                paddingLeft="14"
                                paddingRight="14"
                                marginRight="24"
                                borderThickness="2"
                                borderColor="@theme/color/grey_3"
                                visibility="gone">
                                <brls:Label
                                    id="movie/parental/rating"
                                    singleLine="true"
                                    fontSize="24"
                                    fontWeight="medium" />
                            </brls:Box>
                            <brls:Label
                                id="movie/meta/sep4"
                                fontSize="24"
                                visibility="gone"
                                text="  •  " />
                            <brls:Label
                                id="movie/label/runtime"
                                fontSize="24"
                                fontWeight="medium"
                                singleLine="true" />
                            <brls:Label
                                id="movie/meta/sep3"
                                fontSize="24"
                                visibility="gone"
                                text="  •  " />
                            <brls:Label
                                id="movie/label/country"
                                fontSize="24"
                                fontWeight="medium"
                                singleLine="true"
                                visibility="gone" />
                            <brls:Box
                                axis="row"
                                alignItems="center"
                                marginLeft="24"
                                visibility="gone">
                                <SVGImage
                                    id="movie/audience/icon"
                                    width="18"
                                    height="18"
                                    marginRight="8"
                                    svg="@res/icon/rating/rt_upright.svg" />
                                <brls:Label
                                    id="movie/label/audience"
                                    singleLine="true"
                                    fontSize="24" />
                            </brls:Box>
                        </brls:Box>
                    </brls:Box>
                </brls:Box>
            </brls:Box>

                    <!-- Stremio sources (BELOW the synopsis): one focusable row
                         per playable release (A = play, X = download) + one
                         summary row per non-playable group (torrents/links).
                         Stays GONE for backends that play a single resolved file
                         (Plex/Jellyfin). Built in C++ (media_movie.cpp::buildSources). -->
            <!-- moved out of the hero: it is a full-width list under the
                 backdrop now, not a column beside a poster -->
            <brls:Box
                id="movie/sources"
                axis="column"
                visibility="gone"
                marginTop="16"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides" />

            <!-- full-width rows under the poster block: insets inside the
                 scroll, the cards slide up to the edges;
                 ~28 between the end of a row and the next Header -->
            <brls:Header
                marginTop="28"
                marginBottom="6"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides"
                id="movie/label/people"
                title="@i18n/main/media/cast" />

            <HRecyclerFrame
                height="250"
                itemWidth="140"
                itemSpace="18"
                marginBottom="28"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                id="movie/people" />

            <brls:Box
                id="movie/related/box"
                axis="column" />

        </brls:Box>

    </brls:ScrollingFrame>
</brls:Box>
