<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- StreamBackdrop: the item's art fills the screen at ~0.5 alpha with a
         horizontal gradient over it that is opaque at both edges and nearly
         clear in the middle (StreamGradientLayer). Absolute so it never
         affects the layout. -->
    <brls:Box
        positionType="absolute"
        positionTop="0"
        positionLeft="0"
        width="100%"
        height="100%">
        <brls:Image
            id="source/backdrop"
            width="100%"
            height="100%"
            scalingType="fill" />
        <brls:Rectangle
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="100%"
            height="100%"
            color="#0D0D0D80" />
        <!-- the two opaque edges of the reference's horizontal gradient -->
        <brls:Image
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="35%"
            height="100%"
            scalingType="stretch"
            image="@res/img/fade-left-dark.png" />
        <brls:Image
            positionType="absolute"
            positionTop="0"
            positionRight="0"
            width="35%"
            height="100%"
            scalingType="stretch"
            image="@res/img/fade-right-dark.png" />
    </brls:Box>

    <brls:Box
        axis="row"
        grow="1"
        width="100%">

        <!-- LeftContentSection: weight 0.4, contents CENTRED inside a column
             that is 80% of its width (Nuvio centres the logo, the S/E line,
             the episode name and the runtime — it does not left-align them). -->
        <brls:Box
            axis="column"
            width="40%"
            height="100%"
            justifyContent="center"
            alignItems="center"
            paddingLeft="@style/main/content_padding_sides"
            paddingRight="48">
            <brls:Box
                axis="column"
                width="80%"
                alignItems="center">
                <!-- fillMaxWidth x 120dp, Fit, centred -->
                <brls:Image
                    id="source/logo"
                    width="100%"
                    height="240"
                    visibility="gone"
                    scalingType="fit" />
                <!-- displaySmall (36sp) when there is no logo -->
                <brls:Label
                    id="source/title"
                    fontSize="72"
                    horizontalAlign="center"
                    visibility="gone" />
                <!-- titleLarge "S1 E2" -->
                <brls:Label
                    id="source/subtitle"
                    fontSize="40"
                    fontWeight="medium"
                    horizontalAlign="center"
                    marginTop="16"
                    visibility="gone" />
                <!-- bodyLarge episode name -->
                <brls:Label
                    id="source/epname"
                    fontSize="32"
                    horizontalAlign="center"
                    marginTop="8"
                    visibility="gone" />
                <!-- bodyMedium runtime (episode) / bodyLarge genres • year (movie) -->
                <brls:Label
                    id="source/meta"
                    fontSize="28"
                    horizontalAlign="center"
                    marginTop="8"
                    visibility="gone" />
            </brls:Box>
        </brls:Box>

        <!-- RightStreamSection: weight 0.6, padded top/end/bottom by 48dp -->
        <brls:Box
            axis="column"
            grow="1"
            height="100%"
            paddingTop="96"
            paddingBottom="96"
            paddingRight="@style/main/content_padding_sides">

            <!-- fixed 56dp chip row, then a 16dp gap -->
            <brls:Box
                id="source/filters"
                axis="row"
                height="112"
                marginBottom="32"
                alignItems="center" />

            <!-- the cards live on a rounded translucent panel (radii.xl over
                 BackgroundCard at half alpha), not straight on the artwork -->
            <brls:Box
                grow="1"
                axis="column"
                cornerRadius="32"
                backgroundColor="#24242480"
                paddingLeft="32"
                paddingRight="32"
                paddingTop="32"
                paddingBottom="32">

                <brls:Box
                    id="source/message"
                    axis="column"
                    alignItems="center"
                    justifyContent="center"
                    visibility="gone"
                    grow="1">
                    <brls:Label
                        id="source/message/label"
                        fontSize="32"
                        horizontalAlign="center" />
                </brls:Box>

                <brls:ScrollingFrame
                    id="source/scroll"
                    grow="1"
                    scrollingBehavior="centered">
                    <!-- contentPadding: 8dp on three sides, 32dp at the bottom.
                         The side padding also keeps a card's focus ring (drawn
                         ~5px outside its frame) off the panel edge, and the
                         right one clears the scroll indicator. -->
                    <brls:Box
                        id="source/list"
                        axis="column"
                        width="100%"
                        height="auto"
                        paddingLeft="16"
                        paddingRight="26"
                        paddingTop="16"
                        paddingBottom="64" />
                </brls:ScrollingFrame>
            </brls:Box>

        </brls:Box>
    </brls:Box>

</brls:Box>
